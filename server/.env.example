# Copy this file to .env for local development (docker-compose reads a root-level
# .env automatically; running the backend directly picks up server/.env).

# Postgres, used by docker-compose's `db` service. When running the backend
# directly (not via docker-compose) with no DATABASE_URL set, it falls back to
# a local sqlite:///./dev.db file so you don't need Postgres just to poke around.
POSTGRES_USER=raidlytics
POSTGRES_PASSWORD=raidlytics
POSTGRES_DB=raidlytics
DATABASE_URL=postgresql+psycopg2://raidlytics:raidlytics@localhost:5432/raidlytics

# WarcraftLogs API app credentials (https://www.warcraftlogs.com/api/clients/).
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Discord OAuth app (https://discord.com/developers/applications) — used for
# officer login. Register DISCORD_REDIRECT_URI as an OAuth2 redirect on the app.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback

# Random secret used to sign our own session JWTs — NOT a Discord secret.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Where the backend redirects the browser back to after Discord login.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=https://wow-website.onrender.com,http://localhost:3000

# Local Ollama instance backing the "AI Rotation Analysis" feature.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
